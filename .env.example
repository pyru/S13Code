# S13Code contains no provider keys. Provider credentials belong to glc_v3.
GLC_BASE_URL=http://127.0.0.1:8111
S13_GATEWAY_PROVIDER=gemini
S13_PORT=8113
S13_A2A_GRPC_PORT=8114
S13_CHUNK_MODEL=phi4:latest
S13_LIVE_SEMANTIC_CHUNKING=1

# Set this to an absolute path before using local file skills.
S13_SANDBOX_ROOT=/absolute/path/to/S13Code/sandbox

# Durable A2A push: signs/verifies the webhook S13Code sends to itself (or to
# a real federated peer) and authenticates deliveries to /v1/a2a/push.
S13_A2A_PUSH_SIGNING_SECRET=change-me-shared-webhook-secret
S13_A2A_PUSH_RECEIVE_TOKEN=change-me-receiver-bearer-token
# Defaults to this same server (self-contained "remote report" demo). Point
# it at a real peer's base URL for actual federation.
S13_A2A_REMOTE_URL=http://127.0.0.1:8113

# Per-completion budget. An A2A-delegated run chains two completions, so a
# slow local model (phi4 on CPU) needs more than the 120s default.
S13_GATEWAY_TIMEOUT_SECONDS=300
